; Engine configuration file.
; Far a Way project layout for Godot 4.7.2.
config_version=5

[application]
config/name="Far a Way"
config/description="Far a Way 0.1.0.3 — Windows procedural voxel landscape exploration."
config/version="0.1.0.3"
config/icon="res://icon.svg"
run/main_scene="res://scenes/menu.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]
GameSettings="*res://scripts/systems/game_settings.gd"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[rendering]
anti_aliasing/quality/msaa_3d=1
anti_aliasing/quality/screen_space_aa=0
renderer/rendering_method="forward_plus"
textures/default_filters/use_nearest_mipmap_filter=false
rendering/shading/overrides/force_vertex_shading=false

